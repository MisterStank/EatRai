# --- required ---
DATABASE_URL=postgres://eatrai:eatrai@localhost:5432/eatrai?sslmode=disable
JWT_SECRET=dev-secret-change-me

# --- optional ---
REDIS_URL=redis://localhost:6379/0
HTTP_ADDR=:8080
ACCESS_TTL=1h
REFRESH_TTL=720h

# Identity providers. Comma-separate every OAuth client id whose tokens you
# accept. Google: the iOS, Android and Web client ids from the same GCP project
# (the id_token's aud is whichever platform signed in). Apple: your app's
# bundle id, plus any Services ID used for web.
GOOGLE_CLIENT_IDS=1234-ios.apps.googleusercontent.com,1234-web.apps.googleusercontent.com
APPLE_CLIENT_IDS=app.eatrai.mobile
# DEV ONLY: mounts POST /v1/auth/dev {handle} that mints tokens with no OAuth.
DEV_LOGIN=true

# Google Places (New). Without a key the sync worker is a no-op — use `make seed`.
GOOGLE_PLACES_API_KEY=
# "lat,lng,radiusM;lat,lng,radiusM" — points refreshed every SYNC_INTERVAL
SYNC_POINTS=13.7440,100.5330,3000;13.7290,100.5690,3000
SYNC_INTERVAL=24h
