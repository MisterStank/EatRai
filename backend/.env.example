# Copy to .env. With no key the service runs in MOCK mode (generated Bangkok
# restaurants) so the app works offline.

HTTP_ADDR=:8080
CACHE_TTL=10m

# Allowed browser origin(s) for the web build, comma separated. "*" in dev; set
# to the real origin(s) in production.
CORS_ORIGIN=*

# Reject requests to the paid endpoints whose Origin/Referer isn't in
# CORS_ORIGIN. Requests with no Origin and no Referer still pass (native apps,
# monitors) — the rate limiter is the backstop for those. Ignored when
# CORS_ORIGIN is "*". Set to false for staging / preview deploys on other
# origins.
REQUIRE_ORIGIN=true

# Max requests per client IP per minute on /nearby, /place, /list, /geocode.
# 0 disables.
RATE_LIMIT_RPM=60

# Google Places API (New) — enable "Places API (New)" in Google Cloud, create a
# key, restrict it to that API. Leave blank to stay in mock mode.
GOOGLE_PLACES_API_KEY=

# Force mock mode even with a key set.
MOCK=false
