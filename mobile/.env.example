# Copy to .env.local (Expo auto-loads EXPO_PUBLIC_* into the JS bundle).

EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client IDs — create 3 in the SAME Google Cloud project
# (APIs & Services → Credentials):
#   iOS      → bundle id app.eatrai.mobile
#   Android  → package app.eatrai.mobile + your signing SHA-1
#   Web      → used by Expo Go / the dev proxy
# Put ALL THREE in the backend's GOOGLE_CLIENT_IDS so any is an accepted audience.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Also set in app.json → ios.infoPlist.CFBundleURLTypes: the iOS client id
# REVERSED, e.g. com.googleusercontent.apps.1234-abcd
