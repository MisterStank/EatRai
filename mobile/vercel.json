{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-seo.js ; npx expo export --platform web --clear",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/list", "destination": "/api/list" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
