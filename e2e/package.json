{
  "name": "eatrai-e2e",
  "private": true,
  "description": "Playwright end-to-end tests for the EatRai web build and Go proxy",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=mobile",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.0",
    "serve": "14.2.6",
    "typescript": "~5.3.3"
  }
}
